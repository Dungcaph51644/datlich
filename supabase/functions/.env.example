# Server-side only. Add as Edge Function secrets, never as VITE_* variables.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=800
CHAT_ALLOWED_ORIGINS=https://caulongteam.netlify.app,http://127.0.0.1:5173,http://localhost:5173
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied by
# hosted Supabase. The service role is used ONLY for durable rate counters.
# Optional replacement for the legacy public key (keep this a publishable key):
# CHAT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
